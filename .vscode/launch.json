    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch Test",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/Timesheet.Tests/bin/Debug/net8.0/Timesheet.Tests.dll", // Replace with your DLL
            "args": ["--no-build"],
            "cwd": "${workspaceFolder}/Timesheet.Tests",
            "stopAtEntry": false,
            "preLaunchTask": "none"  // No pre-build task before running tests
          }
    ]
}